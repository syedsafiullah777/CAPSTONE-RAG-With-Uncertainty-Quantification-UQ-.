# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Local env / secrets
.env
.env.*
!.env.example

# Hugging Face / model caches (local)
.cache/
hf_cache/
models_cache/
*.gguf
*.bin
*.safetensors

# Data caches (keep .gitkeep; ignore downloaded/generated content)
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep
!data/processed/finqa_profile.json
!data/processed/finqa_pdf_probe.json
# Calibration and final freeze files may be committed when ready.
data/calibration/*.parquet
data/calibration/*.jsonl
data/final/*.parquet
data/final/*.jsonl
!data/final/selected_140_questions.csv
!data/final/sampling_manifest.json
!data/calibration/calibration_questions.csv
!data/calibration/calibration_manifest.json
!results/config/phase4_sampling_manifest.json
!results/config/phase5_calibration_manifest.json

# Knowledge-base artefacts (documents/index are large; keep structure)
knowledge_base/documents/**
!knowledge_base/documents/.gitkeep
knowledge_base/index/**
!knowledge_base/index/.gitkeep
!knowledge_base/index/index_manifest.json
!knowledge_base/index/retrieval_demo.json
!results/config/phase6_index_manifest.json
!results/config/phase7_runtime_fingerprint.json
!results/config/phase7_smoke_test.json
!results/config/phase7_smoke_generate.json
!results/config/phase8_runtime_fingerprint.json
!results/config/phase8_smoke_test.json
!results/config/phase8_single_agent_smoke.json
!results/config/phase8_single_agent_smoke.jsonl
!project_record/evidence/**
!project_record/evidence/artifacts/**

# Results (never silently commit large/raw experiment dumps by default)
results/raw/**
!results/raw/.gitkeep
results/processed/**
!results/processed/.gitkeep
results/final/**
!results/final/.gitkeep
results/checkpoints/**
!results/checkpoints/.gitkeep
results/logs/**
!results/logs/.gitkeep
# Config snapshots may be committed selectively later
results/config/**
!results/config/.gitkeep

# Notebooks checkpoints
.ipynb_checkpoints/
